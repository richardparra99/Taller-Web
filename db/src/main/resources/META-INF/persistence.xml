<?xml version="1.0" encoding="UTF-8"?>

<persistence
        xmlns="https://jakarta.ee/xml/ns/persistence"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence
        https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
        version="3.2">

    <persistence-unit
            name="config-mysql"
            transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <class>org.example.models.ProductoModel</class>

        <properties>

            <!-- DRIVER MYSQL -->
            <property
                    name="jakarta.persistence.jdbc.driver"
                    value="com.mysql.cj.jdbc.Driver"/>

            <!-- BASE DE DATOS -->
            <property
                    name="jakarta.persistence.jdbc.url"
                    value="jdbc:mysql://localhost:3306/db_java?useSSL=false&amp;serverTimezone=UTC"/>

            <!-- USUARIO MYSQL -->
            <property
                    name="jakarta.persistence.jdbc.user"
                    value="root"/>

            <!-- CONTRASEÑA MYSQL -->
            <property
                    name="jakarta.persistence.jdbc.password"
                    value="root"/>

            <!-- HIBERNATE -->
            <property
                    name="hibernate.hbm2ddl.auto"
                    value="update"/>

            <property
                    name="hibernate.show_sql"
                    value="true"/>

            <property
                    name="hibernate.format_sql"
                    value="true"/>

        </properties>

    </persistence-unit>

</persistence>